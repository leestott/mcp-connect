			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/scripts/present_caldova_demo.ps1",
				"reset"
			],
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true,
				"clear": true
			}
		},
		{
			"label": "Caldova: Run guided presentation",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/scripts/run_caldova_presentation.ps1"
			],
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true,
				"clear": true
			}
		},
		{
			"label": "Caldova: Run live terminal/browser presentation",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/scripts/run_caldova_live_presentation.ps1",
				"-WebUrl",
				"${input:caldovaLiveWebUrl}"
			],
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true,
				"clear": true
			}
		}
	],
	"inputs": [
		{
			"id": "openAgentInspector",
			"type": "command",
			"command": "ai-mlstudio.openTestTool",
			"args": {
				"triggeredFrom": "tasks",
				"port": 8088
			}
		},
		{
			"id": "terminate",
			"type": "command",
			"command": "workbench.action.tasks.terminate",
			"args": "terminateAll"
		},
		{
			"id": "caldovaLiveWebUrl",
			"type": "promptString",
			"description": "Authenticated Caldova HTTPS website URL"
		}
	]
}