				"Bypass",
				"-File",
				"${workspaceFolder}/scripts/present_caldova_demo.ps1",
				"approve"
			],
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true,
				"clear": true
			}
		},
		{
			"label": "Caldova: DEMO 05 - Replay",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/scripts/present_caldova_demo.ps1",
				"replay"
			],
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true,
				"clear": true
			}
		},
		{
			"label": "Caldova: Show audit evidence",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
