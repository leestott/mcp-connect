{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Validate Caldova Agent Prerequisites",
			"type": "aitk",
			"command": "debug-check-prerequisites",
			"args": {
				"portOccupancy": [
					5679,
					8088
				]
			}
		},
		{
			"label": "Run Caldova Agent HTTP Server",
			"type": "shell",
			"command": "${command:python.interpreterPath}",
			"args": [
				"-m",
				"debugpy",
				"--listen",
				"127.0.0.1:5679",
				"-m",
				"agentdev",
				"run",
				"main.py",
				"--verbose",
				"--port",
				"8088",
				"--",
				"--server"
			],
			"isBackground": true,
			"options": {
				"cwd": "${workspaceFolder}/caldova-recall-control/src/agent-framework-workflows-responses"
			},
			"dependsOn": [
				"Validate Caldova Agent Prerequisites"
			],
			"problemMatcher": {
				"pattern": [
					{
						"regexp": "^.*$",
						"file": 0,
						"location": 1,
						"message": 2
					}
				],
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*",
					"endsPattern": "Application startup complete|[Rr]unning on|Started server process"
				}
			}
		},
		{
			"label": "Open Caldova Agent Inspector",
			"type": "shell",
			"command": "echo '${input:openAgentInspector}'",
			"presentation": {
				"reveal": "never"
			},
			"dependsOn": [
				"Run Caldova Agent HTTP Server"
			]
		},
		{
			"label": "Terminate Caldova Agent Tasks",
			"type": "shell",
			"command": "echo ${input:terminate}",
			"problemMatcher": []
		},
		{
			"label": "Run Caldova Control Tower",
			"type": "process",
			"command": "${workspaceFolder}/caldova-recall-control/.venv/Scripts/python.exe",
			"args": [
				"-m",
				"uvicorn",
				"control_tower_api:app",
				"--app-dir",
				"src",
				"--host",
				"127.0.0.1",
				"--port",
				"8091"
			],
			"isBackground": true,
			"options": {
				"cwd": "${workspaceFolder}/caldova-recall-control"
			},
			"problemMatcher": {
				"pattern": [
					{
						"regexp": "^.*$",
						"file": 0,
						"location": 1,
						"message": 2
					}
				],
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*",
					"endsPattern": "Uvicorn running on"
				}
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": false,
				"clear": true
			}
		},
		{
			"label": "Caldova: Presentation Preflight",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/scripts/present_caldova_demo.ps1",
				"preflight"
			],
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true,
				"clear": true
			}
		},
		{
			"label": "Caldova: DEMO 01 - MCP inspection",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/scripts/present_caldova_demo.ps1",
				"inspect"
			],
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true,
				"clear": true
			}
		},
		{
			"label": "Caldova: DEMO 02 - Run analysis",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
