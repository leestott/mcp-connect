              "name": "AZURE_TENANT_ID",
              "value": "[parameters('tenantId')]"
            },
            {
              "name": "AZURE_CLIENT_ID",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('webAppName'))), '2023-01-31').clientId]"
            },
            {
              "name": "CALDOVA_AGENT_ENDPOINT",
              "value": "[parameters('agentEndpoint')]"
            },
            {
              "name": "CALDOVA_STATE_CONTAINER_URL",
              "value": "[format('{0}{1}', reference(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2023-05-01').primaryEndpoints.blob, 'sessions')]"
            },
            {
              "name": "CALDOVA_PUBLIC_ORIGIN",
              "value": "[variables('origin')]"
            },
            {
              "name": "CALDOVA_ALLOWED_USERS",
              "value": "[join(parameters('allowedUserIds'), ',')]"
            },
            {
              "name": "CALDOVA_APPROVERS",
              "value": "[join(parameters('approverIds'), ',')]"
            },
            {
              "name": "AZURE_AI_MODEL_DEPLOYMENT_NAME",
              "value": "[parameters('modelDeploymentName')]"
            },
            {
              "name": "OVERRIDE_USE_MI_FIC_ASSERTION_CLIENTID",
              "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('webAppName'))), '2023-01-31').clientId]"
            },
            {
              "name": "WEBSITE_AUTH_AAD_ALLOWED_TENANTS",
              "value": "[parameters('tenantId')]"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', format('{0}-plan', parameters('webAppName')))]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', parameters('storageAccountName'), 'default', 'sessions')]",
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', parameters('webAppName')))]"
